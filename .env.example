# AntiAngler environment template.
#
# Copy to `.env` (at the repo root or inside scripts/) and fill in your values:
#     cp .env.example .env
# `.env` is gitignored — never commit real credentials. Every script loads .env from both the
# repo root and scripts/ (via python-dotenv, soft-imported, so a missing .env is not fatal).
#
# NOTE: the offline test suite + the tests.yml CI use NONE of these — they are pure stdlib. These
# are only needed to run the live data-fetch stages.

# ─────────────────────────── Credentials ───────────────────────────
# Global Fishing Watch API token — required by gfw_fetch.py and gfw_vessels.py.
# Free (registration): https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=

# AISStream.io API key — required by aisstream_fetch.py (live AIS stream).
# Free (registration): https://aisstream.io/
AISSTREAM_API_KEY=

# OPTIONAL. Planetary Computer subscription key — sat_fetch.py works WITHOUT it (PC is open);
# a key only raises rate limits. Leave blank unless you have one.
PC_SDK_SUBSCRIPTION_KEY=

# ─────────────────────────── Optional knobs ───────────────────────────
# Every CLI flag on every script ALSO has an env-var fallback (precedence: CLI > env > default),
# so you can persist defaults here instead of typing them each run. They are grouped by prefix —
# run `python scripts/<script>.py --help` for the full list + defaults of any one:
#
#   GFW_*    gfw_fetch.py           (GFW_REGION_ID, GFW_REGION_DATASET, GFW_GEAR, GFW_START, GFW_END, …)
#   SAT_*    sat_fetch.py           (SAT_PROVIDER {pc,s1}, SAT_MAX_CLOUD, SAT_TILE_SIZE, SAT_STRETCH, …)
#   DET_*    detect_boats.py        (DET_WEIGHTS, DET_CONF, DET_IMGSZ, DET_WATER_ONLY, …)
#   EXPORT_* export_labels.py       |  REVIEW_*  review_server.py
#   FUSE_*   fuse_violations.py     (FUSE_DT_MINUTES, FUSE_SLACK_M, FUSE_MAX_SPEED_KN, FUSE_MATCHED_WEIGHT, FUSE_FISHING_WEIGHT, …)
#   AIS_*    aisstream_fetch.py     (AIS_DURATION, AIS_MAX_MESSAGES, AIS_MESSAGE_TYPES, AIS_DEDUP, …)
#   GFWV_*   gfw_vessels.py         (GFWV_START, GFWV_END, GFWV_INSIGHTS, GFWV_WDPA_ID, …)
#   MC_*     marinecadastre_fetch.py (MC_START, MC_END, MC_WDPA_ID, MC_DATE, …)
#   SCAN_*   scan_violations.py     |  REPORT_*  report_violations.py
#
# Examples (uncomment + set to override the built-in defaults):
# GFW_GEAR=trawlers,longliners
# SAT_PROVIDER=pc
# FUSE_DT_MINUTES=30
# FUSE_MAX_SPEED_KN=25
